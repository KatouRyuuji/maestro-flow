# Team collaboration — per-member JSON files use union merge to prevent
# conflicts when two members join or update concurrently.
.workflow/collab/members/*.json merge=union

# Activity log is append-only; union merge preserves lines from both sides.
.workflow/collab/activity.jsonl merge=union

# Generated docs and cross-platform mirrors are byte-compared in release gates.
# Keep their text stable in Windows fresh checkouts.
*.md text eol=lf
*.toml text eol=lf

# Search-ranking release gates compare fixture/schema/contract bytes by hash
# (qrels/baseline/corpus/holdouts + built-search-adapter contract). autocrlf
# CRLF conversion changes their sha256 and breaks clean-checkout parity, so pin
# them LF-stable too (same rationale as *.md / *.toml above).
src/search/evaluation/fixtures/*.json text eol=lf
src/search/evaluation/built-search-adapter-contract.json text eol=lf
shared/built-search-adapter-contract.mjs text eol=lf
shared/built-search-adapter-contract.d.mts text eol=lf

# The attestation module embeds an executable bootstrap extracted with exact LF
# byte delimiters. CRLF conversion makes the certified boundaries unfindable.
scripts/search-ranking-module-attestation.mjs text eol=lf
